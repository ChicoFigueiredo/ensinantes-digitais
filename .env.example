ED_ACERVO=./acervo
# Banco alternativo, para subir um painel de teste sem tocar no de verdade.
# Deixe comentado no uso normal — progresso, anotação e preferência só existem
# no banco, e não há como refazê-los a partir do disco.
# ED_BANCO=/tmp/painel-teste.db
ED_PAINEL_PORTA=17789
ED_PAINEL_HOST=127.0.0.1
ED_WHISPER_MODELO=large-v3
ED_WHISPER_COMPUTE=float16
ED_WHISPER_BATCH=16
ED_DIVERGENCIA_PALAVRAS=0.85
ED_DIVERGENCIA_SIMILARIDADE=0.75
